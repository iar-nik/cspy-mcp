# --- Thrift backend connection (direct, only used when registry is not) ---
THRIFT_HOST=127.0.0.1
THRIFT_PORT=9090
THRIFT_TIMEOUT_MS=15000

# --- Thrift IDL locations (optional) ---
# If omitted, the server auto-detects the bundled thrift/cspy.thrift in this repo
# and uses its directory as include path. Only set these for external IDLs.
#THRIFT_FILE=E:\path\to\cspy.thrift
#THRIFT_INCLUDE_DIRS=E:\path\to\thrift\includes

# --- Service Registry resolution (external mode) ---
# Recommended with an already-running CSpyServer2 -standalone: set the registry
# port it prints, and the bridge auto-resolves the real service endpoints.
THRIFT_REGISTRY_HOST=127.0.0.1
THRIFT_REGISTRY_PORT=
THRIFT_REGISTRY_SERVICE=debugger

# --- Managed backend mode (default) ---
# managed: MCP server spawns CSpyServer2 itself and auto-detects the registry port.
# external: connect to an existing CSpyServer2/registry (see registry vars above).
THRIFT_CSPYSERVER_MODE=managed
# Path to CSpyServer2.exe (can also be passed via --cspyserver2 CLI flag).
#THRIFT_CSPYSERVER_EXE=C:\iar\qtarm-10.2.1\common\bin\CSpyServer2.exe
THRIFT_CSPYSERVER_ARGS=-standalone -sockets
THRIFT_CSPYSERVER_START_TIMEOUT_MS=20000
THRIFT_CSPYSERVER_RESTART_ON_FAILURE=1

# --- Auto-registered handler services (defaults are on) ---
#THRIFT_AUTO_EVENTHANDLER=1
#THRIFT_AUTO_LIBSUPPORT=1
#THRIFT_EVENTHANDLER_CLIENT_TIMEOUT_MS=3600000
#THRIFT_LIBSUPPORT_CLIENT_TIMEOUT_MS=3600000
#THRIFT_LISTWINDOW_CLIENT_TIMEOUT_MS=3600000

# --- MCP transport (default: stdio) ---
#MCP_TRANSPORT=streamable-http
#MCP_HOST=127.0.0.1
#MCP_PORT=8000
